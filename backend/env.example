# =============================================
# DeepAudit v3.0.0 Backend 配置文件
# =============================================
# 复制此文件为 .env 并填入实际配置
# 详细说明请参阅 docs/CONFIGURATION.md

# =============================================
# 数据库配置
# =============================================
# PostgreSQL 数据库连接配置
# Docker Compose 部署时使用 db 作为服务器地址
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deepaudit

# 完整数据库连接字符串（可选，会覆盖上述配置）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/deepaudit

# 数据库连接池
# ⚠️ 批量审计时每个 AgentTask 会全程独占一个连接（会话包住整个审计生命周期），
# 必须满足：BATCH_AUDIT_MAX_CONCURRENCY < (DB_POOL_SIZE + DB_MAX_OVERFLOW) / 2，
# 否则并发跑满时连接池耗尽，连登录、项目列表等普通接口也会一起挂死。
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

# =============================================
# 安全配置
# =============================================
# JWT 签名密钥 - 生产环境必须修改为随机字符串！
# 建议使用: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT 加密算法
ALGORITHM=HS256

# Token 过期时间（分钟），默认 8 天
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# =============================================
# Casdoor SSO 单点登录配置
# =============================================
# 是否启用 Casdoor SSO（true 后前端登录页仅提供 SSO 登录入口）
CASDOOR_ENABLED=false

# Casdoor 服务地址（门户固定地址，一般无需修改）
CASDOOR_ENDPOINT=https://portal.msuncloud.cn

# 应用凭证（Casdoor 管理后台 → 应用编辑页获取）
# ⚠ CLIENT_SECRET 仅服务端使用，禁止下发前端或提交到版本库
CASDOOR_CLIENT_ID=your_casdoor_client_id
CASDOOR_CLIENT_SECRET=your_casdoor_client_secret

# OAuth 授权范围（必须包含 openid）
CASDOOR_SCOPE=openid profile email

# 后端 OAuth 回调地址（须与 Casdoor 后台 Redirect URIs 完全一致）
# ⚠ 必须是“浏览器可访问”且与前端同源的地址，Cookie 才能在 login/callback 间往返：
#   - 本地开发(vite 5173 代理 /api): http://localhost:5173/api/v1/auth/sso/callback
#   - 生产(nginx 统一入口):          https://your-app.com/api/v1/auth/sso/callback
CASDOOR_REDIRECT_URI=http://localhost:5173/api/v1/auth/sso/callback

# 前端站点地址（SSO 完成后重定向回前端携带令牌）
#   - 本地开发: http://localhost:5173
#   - 生产:     https://your-app.com
CASDOOR_FRONTEND_URL=http://localhost:5173

# CAS 风格登出页 owner/app 路径段（浏览器友好登出回跳，一般用默认值）
CASDOOR_LOGOUT_OWNER=zymsunsoft
CASDOOR_LOGOUT_APP=portal

# =============================================
# LLM 通用配置
# =============================================
# 支持的 provider:
# - LiteLLM 适配器: openai, gemini, claude, qwen, deepseek, zhipu, moonshot, ollama
# - 原生适配器: baidu, minimax, doubao
LLM_PROVIDER=openai

# API 密钥
LLM_API_KEY=sk-your-api-key

# 模型名称（留空使用 provider 默认模型）
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Gemini: gemini-2.0-flash, gemini-1.5-pro
# Claude: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Qwen: qwen-turbo, qwen-plus, qwen-max
# DeepSeek: deepseek-chat, deepseek-coder
# Zhipu: glm-4-flash, glm-4
# Moonshot: moonshot-v1-8k, moonshot-v1-32k
# Ollama: llama3, codellama, qwen2.5, deepseek-coder
LLM_MODEL=

# 自定义 API 端点（API 中转站）
# 示例: https://your-proxy.com/v1
LLM_BASE_URL=

# 请求超时时间（秒）
LLM_TIMEOUT=150

# 生成温度（0-1，越低越确定性）
LLM_TEMPERATURE=0.1

# 最大生成 Token 数
LLM_MAX_TOKENS=4096

# =============================================
# 各平台独立配置（可选）
# =============================================
# 如果需要同时配置多个平台，可以单独设置
# 运行时可通过 /admin 页面切换

# OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
# GEMINI_API_KEY=xxx

# Anthropic Claude
# CLAUDE_API_KEY=sk-ant-xxx

# 阿里云通义千问
# QWEN_API_KEY=sk-xxx

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxx

# 智谱 AI
# ZHIPU_API_KEY=xxx

# 月之暗面 Kimi
# MOONSHOT_API_KEY=sk-xxx

# 百度文心一言（格式: api_key:secret_key）
# BAIDU_API_KEY=your_api_key:your_secret_key

# MiniMax
# MINIMAX_API_KEY=xxx

# 字节豆包
# DOUBAO_API_KEY=xxx

# Ollama 本地模型
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================
# Agent 审计配置 (Multi-Agent v3.0.0 核心必须)
# =============================================
# Agent 审计开关（必须开启，是核心功能）
AGENT_ENABLED=true

# Agent 最大迭代次数
AGENT_MAX_ITERATIONS=5

# Agent 单次审计超时时间（秒）
AGENT_TIMEOUT=1800

# Redis 配置（Agent 任务队列 - 必须）
# Docker Compose 部署时使用 redis 作为服务器地址
REDIS_URL=redis://localhost:6379/0

# =============================================
# 嵌入模型配置（RAG 功能，独立于主 LLM）
# =============================================
# 嵌入模型 provider: openai, ollama, cohere, huggingface
EMBEDDING_PROVIDER=openai

# 嵌入模型名称
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Ollama: nomic-embed-text, mxbai-embed-large
EMBEDDING_MODEL=text-embedding-3-small

# 嵌入模型 API Key（留空则使用 LLM_API_KEY）
EMBEDDING_API_KEY=

# 嵌入模型 Base URL（留空则使用默认值）
EMBEDDING_BASE_URL=

# =============================================
# 向量数据库配置（RAG 功能）
# =============================================
# 向量数据库类型: chroma
VECTOR_DB_TYPE=chroma

# ChromaDB 配置（本地模式）
CHROMA_PERSIST_DIRECTORY=./data/chroma

# =============================================
# 沙箱配置（漏洞验证 - 核心必须）
# =============================================
# 沙箱功能开关（必须开启，是漏洞验证的核心组件）
SANDBOX_ENABLED=true

# 沙箱 Docker 镜像
# 构建方式 1: docker compose build sandbox
# 构建方式 2: cd docker/sandbox && ./build.sh
SANDBOX_IMAGE=deepaudit/sandbox:latest

# 沙箱内存限制
SANDBOX_MEMORY_LIMIT=512m

# 沙箱 CPU 限制（核心数）
SANDBOX_CPU_LIMIT=1.0

# 是否禁用沙箱网络（安全建议开启）
SANDBOX_NETWORK_DISABLED=true

# 沙箱执行超时时间（秒）
SANDBOX_TIMEOUT=30

# =============================================
# Git 仓库配置
# =============================================
# GitHub Personal Access Token
# 获取地址: https://github.com/settings/tokens
# 权限要求: repo (私有仓库) 或 public_repo (公开仓库)
GITHUB_TOKEN=

# GitLab Personal Access Token
# 获取地址: https://gitlab.com/-/profile/personal_access_tokens
# 权限要求: read_repository
GITLAB_TOKEN=

# Gitea Access Token
# 获取地址: https://[your-gitea-instance]/user/settings/applications
# 权限要求: read_repository
GITEA_TOKEN=

# =============================================
# 扫描配置
# =============================================
# 单次扫描最大文件数
MAX_ANALYZE_FILES=0

# 单文件最大大小（字节），默认 200KB
MAX_FILE_SIZE_BYTES=204800

# LLM 并发请求数（注意 API 限流）
LLM_CONCURRENCY=3

# LLM 请求间隔（毫秒），避免触发限流
LLM_GAP_MS=2000

# =============================================
# 存储配置
# =============================================
# ZIP 文件存储目录
ZIP_STORAGE_PATH=./uploads/zip_files

# Agent 任务临时目录（按 task_id 分子目录存放克隆的仓库/解压的 ZIP，任务结束自动清理）
# 批量审计大量项目时请确保该目录所在分区有足够空间
AGENT_TASK_TEMP_DIR=/tmp/deepaudit

# =============================================
# 定时批量审计配置
# =============================================
# 是否启用进程内调度器（关闭后仍可通过接口手动触发批次）
BATCH_AUDIT_ENABLED=true

# 单批次允许的最大并发项目数（创建/修改计划时的校验上限）
# 调高前请先确认数据库连接池容量（见上方 DB_POOL_SIZE / DB_MAX_OVERFLOW 的约束）
BATCH_AUDIT_MAX_CONCURRENCY=10

# 调度器轮询间隔（秒）
BATCH_AUDIT_TICK_SECONDS=30

# 服务停机时等待在跑批次收尾的上限（秒）
# 必须小于容器的 stop_grace_period，否则收尾会被 SIGKILL 打断，
# 导致批次状态滞留 running、克隆的仓库目录不被清理
BATCH_AUDIT_SHUTDOWN_TIMEOUT=25

# 全局 LLM 并发上限（整个进程所有审计任务共享），0 表示不限制
# 批量审计时 N 个任务 × 每任务多个子 Agent 会直打上游，极易触发 429；
# 单个任务同时等 LLM 的 Agent 数远低于该值，因此默认限流不影响单任务场景
AGENT_GLOBAL_LLM_CONCURRENCY=10

# =============================================
# 输出配置
# =============================================
# 分析结果输出语言
# zh-CN: 中文
# en-US: 英文
OUTPUT_LANGUAGE=zh-CN
